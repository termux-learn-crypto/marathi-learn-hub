## Workflow per round (L6, no sentinel needed except last lesson python-mega-project):
# 1. write scripts/adds_<tag>N.py  (AD dict of section->list of merged lines)
# 2. junk-scan: no English-only tokens, no translit, foreign scripts none
# 3. python3 scripts/expand.py python-level6 <slug> scripts/adds_<tag>N.py
# 4. node node_modules/typescript/bin/tsc --noEmit  (expect TSC_OK)
# 5. rm -rf tssrc2 && NODE_PATH=... node chk1.js <slug> | grep -E "words=|FAIL"
# 6. node audit_slug.js <slug> python-level6 | grep -v "LATIN:" | head -3
# 7. repeat until words>=5000 AND no FAIL AND clean audit.

# audit_slug.js now takes level file as argv[3]: python-level6 (default python-level5).
# Junk fix directly in TS with src.replace(a,b) when a junk token slips past (persists in TS).

