{
  "name": "marathi-coding-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/next/dist/bin/next lint",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/tsx/dist/cli.mjs scripts/check-content.ts",
    "audit": "node node_modules/tsx/dist/cli.mjs scripts/audit.ts",
    "audit:content": "node scripts/audit-content.js",
    "prettier:check": "node node_modules/prettier/bin/prettier.cjs --check \"src/**/*.{ts,tsx}\"",
    "prettier:write": "node node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,tsx}\"",
    "icons": "node scripts/generate-icons.js",
    "postinstall": "node scripts/patch-next-swc.js"
  },
  "dependencies": {
    "next": "^15.5.25",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.4.33",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
