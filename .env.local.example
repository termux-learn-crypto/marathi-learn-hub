# Google AdSense
# NOTE: Ads render ONLY when NEXT_PUBLIC_ADSENSE_SLOT is set. Set the real values in
# Vercel → Project Settings → Environment Variables (or local .env.local) to enable ads.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_SLOT=1234567890

# Canonical domain (production / custom domain)
SITE_URL=https://marathi-learn-hub.vercel.app